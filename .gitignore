# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── FRONTEND ───────────────────────────────────────────────────────────────────

# dependencies
frontend/node_modules/

# next.js
frontend/.next/
frontend/out/

# production
frontend/build/

# typescript
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# vercel
frontend/.vercel

# ─── BACKEND ────────────────────────────────────────────────────────────────────

# Python virtual environment
backend/venv/

# Python cache
backend/__pycache__/
backend/**/__pycache__/
*.pyc
*.pyo

# ─── SHARED ─────────────────────────────────────────────────────────────────────

# env files
.env
.env.*
!.env.example

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# testing
coverage/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Docker
postgres_data/